# Copy to .env.local for local dev; set the same two in Vercel → Project → Settings → Environment Variables.
# Supabase → Project Settings → API Keys. Use the ANON (public) key, never the service_role key:
# this file is shipped to the browser. Row-level security limits access to the owner email.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
